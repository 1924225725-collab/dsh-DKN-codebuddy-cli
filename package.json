{
  "name": "dsh-codebuddy-cli-cn",
  "displayName": "DSH CodeBuddy CLI（国内版）",
  "description": "自动检测官方 CodeBuddy CLI 国内模型与积分倍率，支持一键配置 CLI，工具由 DSH 管理。",
  "version": "0.4.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/1924225725-collab/dsh-codebuddy-cli-cn.git"
  },
  "homepage": "https://github.com/1924225725-collab/dsh-codebuddy-cli-cn#readme",
  "bugs": {
    "url": "https://github.com/1924225725-collab/dsh-codebuddy-cli-cn/issues"
  },
  "scripts": {
    "test": "node --test test/accounts.test.js test/account-plugin.test.js test/diagnostics.test.js test/model-response.test.js test/cli-response.test.js test/model-catalog.test.js test/cli-runtime.test.js test/local-http.test.js test/plugin.test.js test/client.test.js test/usage.test.js test/request.test.js test/request-budget.test.js test/request-size-plugin.test.js test/images.test.js test/cli-image-process.test.js test/image-plugin.test.js test/stream-facts.test.js test/cache-prefix.test.js"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs/安装教程.md",
    "docs/INSTALL.en.md",
    "docs/工作原理.md",
    "docs/ARCHITECTURE.en.md",
    "docs/反馈与日志.md",
    "docs/TROUBLESHOOTING.en.md",
    "docs/images",
    "docs/使用与故障处理指南.md",
    "docs/USER_GUIDE.en.md",
    "docs/工具适配范围.md",
    "docs/TOOL_COMPATIBILITY.en.md",
    "docs/多账号使用指南.md",
    "docs/ACCOUNT_GUIDE.en.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.5",
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-test-renderer": "^18.2.0"
  }
}
