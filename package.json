{
  "name": "dsh-dkn-codebuddy-cli",
  "displayName": "dsh-DKN-codebuddy cli",
  "description": "一个配置入口，两条独立的官方CLI区域通道；账号、模型目录和诊断按区域隔离。",
  "version": "1.0.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/1924225725-collab/dsh-DKN-codebuddy-cli.git"
  },
  "homepage": "https://github.com/1924225725-collab/dsh-DKN-codebuddy-cli#readme",
  "bugs": {
    "url": "https://github.com/1924225725-collab/dsh-DKN-codebuddy-cli/issues"
  },
  "scripts": {
    "test": "node --test test/cn/*.test.js test/intl/*.test.js test/*.test.js"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./intl": "./lib/intl/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5",
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.5",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-test-renderer": "^18.2.0"
  }
}
